# Copiar este archivo a ".env" en la raíz del proyecto y completar con los
# valores reales. El archivo ".env" NUNCA debe subirse a git (ya está en
# .gitignore).
#
# GEMINI_API_KEY y FMM_API_URL/FMM_API_TOKEN comparten este mismo archivo:
# - GEMINI_API_KEY se usa en tiempo de BUILD (vite.config.ts la incrusta en
#   el bundle del cliente). Si la cambias, hay que correr "npm run build" de
#   nuevo para que tome efecto.
# - FMM_API_URL / FMM_API_TOKEN se usan en tiempo de EJECUCIÓN por el
#   servidor (server/index.js). Si las cambias, basta con reiniciar el
#   proceso de PM2, sin necesidad de rebuild.

GEMINI_API_KEY=

# Endpoint del web service del FMM (Boris Beltrán / Zona Franca Cartagena)
FMM_API_URL=http://www.siza.com.co/spdcitas-1.0/api/formulario
FMM_API_TOKEN=

# Puerto donde escucha el servidor Node en producción (server/index.js)
PORT=3000
